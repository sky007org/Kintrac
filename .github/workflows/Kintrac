name: Build Kintrac APK
on:
  push:
    branches: [ main ]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'
      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
      - name: Find and Build App
        run: |
          ls -la
          if [ -f "package.json" ]; then
            echo "Found in root"
            npm install
            npm run build
          elif [ -f "Kintrac/package.json" ]; then
            echo "Found in Kintrac folder"
            cd Kintrac
            npm install
            npm run build
            cd ..
          else
            find . -name "package.json"
            exit 1
          fi
      - name: Build Android APK
        run: |
          if [ -f "Kintrac/package.json" ]; then cd Kintrac; fi
          npm install @capacitor/core @capacitor/cli @capacitor/android
          npx cap init Kintrac com.sky007.kintrac --web-dir=dist || true
          npx cap add android || true
          npx cap copy android || npx cap copy
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Kintrac-APK
          path: |
            android/app/build/outputs/apk/debug/app-debug.apk
            Kintrac/android/app/build/outputs/apk/debug/app-debug.apk
